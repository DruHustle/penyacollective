
{% assign block_settings = block.settings %}
{% liquid
  assign penya_shop_name = shop.name
  if penya_shop_name == 'My Store'
    assign penya_shop_name = 'Penya Collective'
  endif

  assign penya_logo_image = blank
  assign penya_logo_file = blank
  assign penya_logo_asset = ''
  assign penya_logo_candidates = 'logo-penya.png|logo-penya.jpg|logo-penya.jpeg|logo-penya.webp|penya logo.png|penya logo.jpg|penya-logo.png|penya-logo.jpg' | split: '|'
  for candidate in penya_logo_candidates
    assign candidate = candidate | strip
    if penya_logo_image == blank and images[candidate] != blank
      assign penya_logo_image = images[candidate]
      assign penya_logo_asset = candidate
      break
    endif
    if penya_logo_file == blank and files[candidate] != blank
      assign penya_logo_file = files[candidate]
      assign penya_logo_asset = candidate
      break
    endif
  endfor
  if penya_logo_asset == '' and penya_logo_candidates.size > 0
    assign penya_logo_asset = penya_logo_candidates[0]
  endif
%}
<div
  class="
    footer-utilities__group-copyright
    custom-typography
    {% if block_settings.font_size != "" %}custom-font-size{% endif %}
  "
  style="{% render 'typography-style', preset: 'custom', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <span class="footer-utilities__text">
    &copy; {{ 'now' | date: '%Y' }}
    <a href="{{ routes.root_url }}" class="footer-utilities__logo" aria-label="{{ penya_shop_name }}">
      {% if penya_logo_image != blank %}
        {{-
          penya_logo_image
          | image_url: height: 18
          | image_tag: class: 'penya-logo--footer', alt: penya_shop_name
        -}}
      {% elsif penya_logo_file != blank %}
        <img
          src="{{ penya_logo_file | file_url }}"
          class="penya-logo--footer"
          alt="{{ penya_shop_name }}"
          width="200"
          height="80"
          loading="lazy"
        >
      {% elsif penya_logo_asset != '' %}
        <img
          src="{{ penya_logo_asset | asset_url }}"
          class="penya-logo--footer"
          alt="{{ penya_shop_name }}"
          width="200"
          height="80"
          loading="lazy"
        >
      {% else %}
        {% render 'penya-logo', class: 'penya-logo--footer', label: penya_shop_name %}
      {% endif %}
    </a>
    {%- if block_settings.show_powered_by -%}
      , {{ powered_by_link }}
    {%- endif -%}
  </span>
</div>

{% schema %}
{
  "name": "t:names.copyright",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:settings.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:content.manage_store_name"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.copyright",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
