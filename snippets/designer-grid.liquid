{%- comment -%}
  Designer grid on the homepage.

  Dependency mapping:
  - Page data: pages[handle].title, pages[handle].url
  - Metafield data: pages[handle].metafields.custom.hero_image_asset (filename in theme assets)
  - Theme assets: fallback image filenames to ensure the grid never renders empty cards
{%- endcomment -%}

{% liquid
  assign designer_handles = 'designer-ivhu-tribe|designer-a-tribe-called-zimbabwe|designer-feli-nandi|designer-haus-of-stone|designer-panashe|designer-by-bakari' | split: '|'
  assign designer_fallback_titles = 'Ivhu Tribe|A Tribe Called Zimbabwe|Feli Nandi Apparels|Haus of Stone|Panashe Designs|By Bakari' | split: '|'
  assign designer_fallback_assets = 'designer-ivhutribe.jpg|designer-atcz.jpg|designer-felinandi.jpg|designer-hausofstone.jpg|designer-panashe.jpg|designer-bybakari.jpg' | split: '|'
  assign designer_countries = 'Zimbabwe|Zimbabwe|Zimbabwe|Zimbabwe|Zimbabwe|Zimbabwe' | split: '|'
%}

<style>
  .penya-designers__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 2.5rem; }
  .penya-designers__card { display: block; text-decoration: none; color: inherit; }
  .penya-designers__card-image { aspect-ratio: 3/4; overflow: hidden; margin-bottom: 1rem; }
  .penya-designers__card-image img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.4s ease; }
  .penya-designers__card:hover .penya-designers__card-image img { transform: scale(1.04); }
  .penya-designers__card-shop { font-family: var(--font-subheading--family); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  @media (max-width: 989px) { .penya-designers__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; } }
  @media (max-width: 480px) { .penya-designers__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
</style>

<div class="penya-designers">
  <div class="penya-designers__header">
    <p style="font-family: var(--font-subheading--family); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 0.5rem;">The Collective</p>
    <h2 style="font-family: var(--font-heading--family); margin-bottom: 0.75rem;">Shop by Designer</h2>
    <p style="font-family: var(--font-body--family); color: var(--color-foreground); opacity: 0.7; max-width: 480px;">Curated pieces from designers across Africa and beyond.</p>
  </div>
  <div class="penya-designers__grid">
    {% for handle in designer_handles %}
      {% assign index = forloop.index0 %}
      {% assign fallback_title = designer_fallback_titles[index] %}
      {% assign fallback_asset = designer_fallback_assets[index] %}
      {% assign fallback_country = designer_countries[index] %}
      {% assign designer_page = pages[handle] %}
      {% assign designer_title = designer_page.title | default: fallback_title %}
      {% assign fallback_url = '/pages/' | append: handle %}
      {% assign designer_url = designer_page.url | default: fallback_url %}
      {% assign hero_asset = designer_page.metafields.custom.hero_image_asset.value | default: fallback_asset %}
      {% assign image_loading = 'lazy' %}
      {% assign fetch_priority = '' %}
      {% if forloop.index0 < 2 %}
        {% assign image_loading = 'eager' %}
        {% assign fetch_priority = 'high' %}
      {% endif %}
      <a href="{{ designer_url }}" class="penya-designers__card">
        <div class="penya-designers__card-image">
          <img
            src="{{ hero_asset | asset_url }}"
            alt="{{ designer_title | escape }}"
            loading="{{ image_loading }}"
            width="900"
            height="1200"
            {% if fetch_priority != '' %}fetchpriority="{{ fetch_priority }}"{% endif %}
          >
        </div>
        <p style="font-family: var(--font-subheading--family); font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 0.25rem;">{{ fallback_country }}</p>
        <h3 style="font-family: var(--font-heading--family); margin: 0 0 0.5rem; font-size: 1.25rem;">{{ designer_title }}</h3>
        <span class="penya-designers__card-shop">Read the Story</span>
      </a>
    {% endfor %}
  </div>
</div>
