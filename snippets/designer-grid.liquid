{%- comment -%}
  Designer grid on the homepage.

  Primary data source: Metaobjects
    Shopify Admin → Content → Metaobjects → Designer
    • Add entry       — new designer card appears on the homepage grid
    • Set to Hidden    — hides the designer from the storefront
    • Set to Published — shows the designer on the storefront
    • Delete entry    — permanently removes the designer from the grid
    • Drag to reorder — controls the left-to-right display order

  Metaobject fields:
    name         (single_line_text) — brand name displayed on the card
    country      (single_line_text) — origin label shown above the name
    hero_image   (file_reference)   — portrait/card image (upload via file picker)
    page_handle  (single_line_text) — page slug, e.g. "designer-ivhu-tribe"

  Image fallback chain (per card):
    1. hero_image metaobject field (file_reference, uploaded in admin)
    2. pages[page_handle].metafields.custom.hero_image_asset (legacy seed asset)

  Hardcoded fallback: used only when the metaobject definition has not been
  set up yet. Run scripts/setup-designer-metaobjects.mjs once to migrate to
  the admin-managed approach.

  When all designers are Hidden and metaobjects are active, this snippet
  outputs nothing — the surrounding section collapses to zero height.

  NOTE: The section heading is static branding copy editable directly in this file.
{%- endcomment -%}

{% liquid
  assign designers       = shop.metaobjects.designer.values
  # shop.metaobjects.designer is non-blank whenever the definition exists,
  # even when every entry is Hidden (values would be empty).
  # This prevents the hardcoded fallback from appearing when all designers
  # have been intentionally hidden via Admin.
  assign use_metaobjects = false
  if shop.metaobjects.designer
    assign use_metaobjects = true
  endif

  unless use_metaobjects
    assign designer_handles         = 'designer-ivhu-tribe|designer-a-tribe-called-zimbabwe|designer-feli-nandi|designer-haus-of-stone|designer-panashe|designer-by-bakari' | split: '|'
    assign designer_fallback_titles = 'Ivhu Tribe|A Tribe Called Zimbabwe|Feli Nandi Apparels|Haus of Stone|Panashe Designs|By Bakari' | split: '|'
    assign designer_fallback_assets = 'designer-ivhutribe.jpg|designer-atcz.jpg|designer-felinandi.jpg|designer-hausofstone.jpg|designer-panashe.jpg|designer-bybakari.jpg' | split: '|'
    assign designer_countries       = 'Zimbabwe|Zimbabwe|Zimbabwe|Zimbabwe|Zimbabwe|Zimbabwe' | split: '|'
  endunless
%}

{%- comment -%}
  Only render when there is content to show.
  When use_metaobjects is true but designers is empty (all Hidden), output
  nothing so the surrounding section collapses cleanly.
{%- endcomment -%}
{% if use_metaobjects == false or designers.size > 0 %}

<style>
  .penya-designers {
    padding-block: 80px;
  }
  .penya-designers__header {
    margin-bottom: 2rem;
  }
  .penya-designers__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  .penya-designers__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 0.75rem;
  }
  .penya-designers__subtext {
    font-family: var(--font-body--family);
    color: var(--color-foreground);
    opacity: 0.7;
    max-width: 480px;
    line-height: 1.6;
  }
  .penya-designers__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 2.5rem;
  }
  .penya-designers__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .penya-designers__card-image {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 1rem;
    background-color: rgb(var(--color-foreground-rgb) / 0.06);
  }
  .penya-designers__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .penya-designers__card:hover .penya-designers__card-image img {
    transform: scale(1.04);
  }
  .penya-designers__card-country {
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }
  .penya-designers__card-name {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
    color: var(--color-foreground-heading);
  }
  .penya-designers__card-cta {
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    display: inline-block;
    transition: opacity 0.2s ease;
  }
  .penya-designers__card:hover .penya-designers__card-cta {
    opacity: 0.6;
  }
  @media (max-width: 989px) {
    .penya-designers__grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (max-width: 749px) {
    .penya-designers { padding-block: 60px; }
    .penya-designers__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }

  /* ── Designer section marquee divider ────────────────────────────── */
  .penya-designers-divider {
    /* Break out of the page-width container to span the full viewport */
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    padding-block: 1.5rem;
  }
  .penya-designers-divider__track {
    display: flex;
    align-items: center;
    gap: 3rem;
    white-space: nowrap;
    width: max-content;
    /* Scrolls left-to-right — opposite direction from the top brand marquee */
    animation: penya-divider-forward 40s linear infinite;
  }
  @keyframes penya-divider-forward {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0%);   }
  }
  .penya-designers-divider__item {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    letter-spacing: 0.05em;
  }
  .penya-designers-divider__sep {
    opacity: 0.35;
    font-size: 0.6rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .penya-designers-divider__track { animation: none; }
  }
</style>

<div class="penya-designers">
  <div class="penya-designers__header">
    <p class="penya-designers__eyebrow">Meet the Collective</p>
    <h2 class="penya-designers__heading">The Collective. One Shared Light.</h2>
    <p class="penya-designers__subtext">Each designer brings a distinct language of heritage, craft, and modern African style. Start with the story, then shop the pieces.</p>
  </div>

  <div class="penya-designers__grid">

    {% if use_metaobjects %}

      {% for designer in designers %}
        {% liquid
          assign index          = forloop.index0
          assign designer_name  = designer.name.value
          assign country        = designer.country.value | default: 'Africa'
          assign page_handle    = designer.page_handle.value
          assign designer_url   = '/pages/' | append: page_handle
          assign hero_image_obj = designer.hero_image.value

          if index < 3
            assign image_loading  = 'eager'
            assign fetch_priority = 'high'
          else
            assign image_loading  = 'lazy'
            assign fetch_priority = ''
          endif

          # Image fallback: metaobject file → page metafield asset
          assign fallback_asset = blank
          if hero_image_obj == blank and page_handle != blank
            assign designer_page  = pages[page_handle]
            assign fallback_asset = designer_page.metafields.custom.hero_image_asset.value
          endif
        %}

        <a
          href="{{ designer_url }}"
          class="penya-designers__card"
          aria-label="Read the story of {{ designer_name }}"
        >
          <div class="penya-designers__card-image">
            {% if hero_image_obj != blank %}
              {{
                hero_image_obj
                | image_url: width: 900
                | image_tag:
                  width: 900,
                  height: 1200,
                  widths: '450, 600, 900',
                  sizes: '(max-width: 480px) 50vw, (max-width: 989px) 50vw, 33vw',
                  loading: image_loading,
                  fetchpriority: fetch_priority,
                  alt: designer_name | append: ' — designer'
              }}
            {% elsif fallback_asset != blank %}
              <img
                src="{{ fallback_asset | asset_url }}"
                alt="{{ designer_name | escape }} — designer"
                loading="{{ image_loading }}"
                width="900"
                height="1200"
                {% if fetch_priority != '' %}fetchpriority="{{ fetch_priority }}"{% endif %}
              >
            {% endif %}
          </div>
          <p class="penya-designers__card-country">{{ country }}</p>
          <h3 class="penya-designers__card-name">{{ designer_name }}</h3>
          <span class="penya-designers__card-cta">Read the Story</span>
        </a>

      {% endfor %}

    {% else %}

      {%- comment -%} Hardcoded fallback — active until metaobjects are configured {%- endcomment -%}
      {% for handle in designer_handles %}
        {% assign index           = forloop.index0 %}
        {% assign fallback_title  = designer_fallback_titles[index] %}
        {% assign fallback_asset  = designer_fallback_assets[index] %}
        {% assign country         = designer_countries[index] %}
        {% assign designer_page   = pages[handle] %}
        {% assign designer_title  = designer_page.title | default: fallback_title %}
        {% assign designer_url    = designer_page.url | default: '/pages/' | append: handle %}
        {% assign hero_asset      = designer_page.metafields.custom.hero_image_asset.value | default: fallback_asset %}

        {%- comment -%} First 3 are in the visible viewport on desktop — load eagerly {%- endcomment -%}
        {% if index < 3 %}
          {% assign image_loading  = 'eager' %}
          {% assign fetch_priority = 'high' %}
        {% else %}
          {% assign image_loading  = 'lazy' %}
          {% assign fetch_priority = '' %}
        {% endif %}

        <a
          href="{{ designer_url }}"
          class="penya-designers__card"
          aria-label="Read the story of {{ designer_title }}"
        >
          <div class="penya-designers__card-image">
            <img
              src="{{ hero_asset | asset_url }}"
              alt="{{ designer_title | escape }} — designer"
              loading="{{ image_loading }}"
              width="900"
              height="1200"
              {% if fetch_priority != '' %}fetchpriority="{{ fetch_priority }}"{% endif %}
            >
          </div>
          <p class="penya-designers__card-country">{{ country }}</p>
          <h3 class="penya-designers__card-name">{{ designer_title }}</h3>
          <span class="penya-designers__card-cta">Read the Story</span>
        </a>
      {% endfor %}

    {% endif %}

  </div>
</div>

<div class="penya-designers-divider color-scheme-1" aria-hidden="true">
  <div class="penya-designers-divider__track">
    {%- for i in (1..2) -%}
      <span class="penya-designers-divider__item">The Collective</span>
      <span class="penya-designers-divider__sep">◆</span>
      <span class="penya-designers-divider__item">Start with the Story</span>
      <span class="penya-designers-divider__sep">◆</span>
      <span class="penya-designers-divider__item">Shop the Pieces</span>
      <span class="penya-designers-divider__sep">◆</span>
      <span class="penya-designers-divider__item">Craft Meets Culture</span>
      <span class="penya-designers-divider__sep">◆</span>
      <span class="penya-designers-divider__item">Stories Worth Wearing</span>
      <span class="penya-designers-divider__sep">◆</span>
    {%- endfor -%}
  </div>
</div>

{% endif %}
