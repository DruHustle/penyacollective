            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "promise": {
          "type": "text",
          "settings": {
            "text": "<h3>Our Responsibility</h3><p>To be Penya is to be intentional — about materials, about people, about the world we leave behind. We produce in small batches from fabrics chosen for durability and conscience: natural fibres that breathe, last, and do less harm. We pay fair wages to every artisan in our supply chain. We design for longevity, not seasons — because the most responsible garment is the one you wear for a decade. That is the exchange we ask you to make with us.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "rte",
