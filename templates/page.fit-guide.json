{
  "sections": {
    "fit_guide_back_nav": {
      "type": "section",
      "blocks": {
        "back_to_shop": {
          "type": "button",
          "settings": {
            "label": "← Continue Shopping",
            "link": "/collections/all",
            "open_in_new_tab": false,
            "style_class": "button-unstyled",
            "width": "fit-content",
            "custom_width": 100,
            "width_mobile": "fit-content",
            "custom_width_mobile": 100
          }
        }
      },
      "block_order": ["back_to_shop"],
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "center",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "flex-start",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 16,
        "section_width": "page-width",
        "section_height": "",
        "section_height_custom": 50,
        "color_scheme": "scheme-2",
        "background_media": "none",
        "video_position": "cover",
        "background_image_position": "cover",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "padding-block-start": 32,
        "padding-block-end": 0
      }
    },
    "fit_guide_main": {
      "type": "fit-guide",
      "blocks": {
        "step_chest": {
          "type": "measurement_step",
          "settings": {
            "title": "Chest / Bust",
            "description": "Wrap the tape around the fullest part of your chest or bust, keeping it parallel to the ground. Breathe naturally — do not pull it tight or hold your breath."
          }
        },
        "step_waist": {
          "type": "measurement_step",
          "settings": {
            "title": "Waist",
            "description": "Measure around your natural waistline — the narrowest point of your torso, usually about an inch above your navel. Exhale gently before reading the tape."
          }
        },
        "step_hips": {
          "type": "measurement_step",
          "settings": {
            "title": "Hips",
            "description": "Stand with your feet together and measure around the fullest part of your hips and seat, roughly 20 cm below your natural waistline. Keep the tape level all the way around."
          }
        },
        "step_height": {
          "type": "measurement_step",
          "settings": {
            "title": "Height",
            "description": "Stand straight in bare feet against a wall. Have someone mark the top of your head and measure to the floor. Useful for judging trouser, dress, and coat lengths."
          }
        },
        "men_xs": {
          "type": "size_row",
          "settings": { "gender": "men", "size_label": "XS", "chest": "80 – 84", "waist": "62 – 66", "hips": "84 – 88" }
        },
        "men_s": {
          "type": "size_row",
          "settings": { "gender": "men", "size_label": "S",  "chest": "84 – 88", "waist": "66 – 70", "hips": "88 – 94" }
        },
        "men_m": {
          "type": "size_row",
          "settings": { "gender": "men", "size_label": "M",  "chest": "88 – 94", "waist": "70 – 76", "hips": "94 – 100" }
        },
        "men_l": {
          "type": "size_row",
          "settings": { "gender": "men", "size_label": "L",  "chest": "94 – 100", "waist": "76 – 82", "hips": "100 – 106" }
        },
        "men_xl": {
          "type": "size_row",
          "settings": { "gender": "men", "size_label": "XL", "chest": "100 – 108", "waist": "82 – 90", "hips": "106 – 112" }
        },
        "men_xxl": {
          "type": "size_row",
          "settings": { "gender": "men", "size_label": "XXL", "chest": "108 – 116", "waist": "90 – 98", "hips": "112 – 120" }
        },
        "women_xs": {
          "type": "size_row",
          "settings": { "gender": "women", "size_label": "XS", "chest": "78 – 82", "waist": "60 – 64", "hips": "86 – 90" }
        },
        "women_s": {
          "type": "size_row",
          "settings": { "gender": "women", "size_label": "S",  "chest": "82 – 86", "waist": "64 – 68", "hips": "90 – 94" }
        },
        "women_m": {
          "type": "size_row",
          "settings": { "gender": "women", "size_label": "M",  "chest": "86 – 92", "waist": "68 – 74", "hips": "94 – 100" }
        },
        "women_l": {
          "type": "size_row",
          "settings": { "gender": "women", "size_label": "L",  "chest": "92 – 98", "waist": "74 – 80", "hips": "100 – 106" }
        },
        "women_xl": {
          "type": "size_row",
          "settings": { "gender": "women", "size_label": "XL", "chest": "98 – 106", "waist": "80 – 88", "hips": "106 – 114" }
        },
        "women_xxl": {
          "type": "size_row",
          "settings": { "gender": "women", "size_label": "XXL", "chest": "106 – 114", "waist": "88 – 96", "hips": "114 – 122" }
        }
      },
      "block_order": [
        "step_chest", "step_waist", "step_hips", "step_height",
        "men_xs", "men_s", "men_m", "men_l", "men_xl", "men_xxl",
        "women_xs", "women_s", "women_m", "women_l", "women_xl", "women_xxl"
      ],
      "settings": {
        "eyebrow": "Your Fit, Your Way",
        "heading": "Finding the right fit should feel effortless.",
        "intro_text": "Penya pieces are designed with care for how clothes feel on a real body. Take two minutes with these four measurements and we will do the rest.",
        "table_heading": "Size Reference",
        "table_note": "All measurements in centimetres. If you are between sizes, size up for a relaxed fit or down for a closer silhouette. Women's column shows bust measurement.",
        "note_heading": "A note on fit",
        "note_text": "Penya pieces are designed with intentional ease — we do not cut for a single body type. Some styles have a relaxed silhouette by design; others are more tailored. Each product page includes specific fit notes where relevant. If you are unsure, our team is always happy to advise."
      }
    }
  },
  "order": ["fit_guide_back_nav", "fit_guide_main"]
}
