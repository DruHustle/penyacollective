{%- comment -%}
  Minimal homepage client care links.

  Dependency mapping:
  - Section blocks: service links for returns, delivery, payment, and client care
{%- endcomment -%}

<section class="penya-trust-band color-{{ section.settings.color_scheme }}" data-testid="penya-trust-band">
  <div class="page-width penya-trust-band__inner">
    <div class="penya-trust-band__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="penya-trust-band__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="penya-trust-band__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.copy != blank %}
        <div class="penya-trust-band__copy rte">
          {{ section.settings.copy }}
        </div>
      {% endif %}
    </div>

    <nav class="penya-trust-band__service-links" aria-label="Client care links">
      {% for block in section.blocks %}
        {% liquid
          assign block_link = block.settings.link
          assign fallback_copy = block.settings.label | append: ' ' | append: block.settings.heading | downcase
          assign link_text = block.settings.label | default: block.settings.link_label | default: block.settings.heading

          if block_link == blank
            if fallback_copy contains 'return'
              assign block_link = '/pages/shipping'
            elsif fallback_copy contains 'deliver' or fallback_copy contains 'dispatch' or fallback_copy contains 'shipping'
              assign block_link = '/pages/shipping'
            elsif fallback_copy contains 'payment'
              assign block_link = '/pages/faq'
            elsif fallback_copy contains 'client care' or fallback_copy contains 'support'
              assign block_link = '/pages/contact'
            endif
          endif
        %}

        {% if link_text != blank and block_link != blank %}
          <a
            href="{{ block_link }}"
            class="penya-trust-band__service-link"
            {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="penya-trust-band__service-link-text">{{ link_text }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </nav>
  </div>
</section>

{% stylesheet %}
  .penya-trust-band {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgb(var(--color-background-rgb)) 0%, rgb(var(--color-foreground-rgb) / 0.02) 100%);
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
  }

  .penya-trust-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .penya-trust-band__intro {
    max-width: 30rem;
  }

  .penya-trust-band__eyebrow {
    margin: 0 0 0.65rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .penya-trust-band__heading {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    line-height: 1.05;
    text-wrap: balance;
    color: var(--color-foreground-heading);
  }

  .penya-trust-band__copy {
    color: rgb(var(--color-foreground-rgb) / 0.78);
    line-height: 1.65;
  }

  .penya-trust-band__service-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.2rem 1.5rem;
    align-content: start;
  }

  .penya-trust-band__service-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-foreground);
    text-decoration: none;
    font-family: var(--font-subheading--family);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.16);
    padding: 0.9rem 0;
    transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .penya-trust-band__service-link::after {
    content: '->';
    font-size: 0.85rem;
    opacity: 0.55;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .penya-trust-band__service-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateX(2px);
  }

  .penya-trust-band__service-link:hover::after {
    transform: translateX(2px);
    opacity: 1;
  }

  .penya-trust-band__service-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-color: var(--color-primary);
  }

  @media screen and (max-width: 989px) {
    .penya-trust-band__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .penya-trust-band__service-links {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Penya trust band",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Client care"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Client care, kept simple."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Returns, delivery, payments, and direct support — clearly linked.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Returns"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "14-day returns on eligible pieces"
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Copy",
          "default": "Unworn items can be returned within 14 days of delivery. Custom and final-sale pieces are excluded."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "View details"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Penya trust band",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "label": "Returns",
            "heading": "14-day returns on eligible pieces",
            "copy": "Unworn items can be returned within 14 days of delivery. Custom and final-sale pieces are excluded.",
            "link_label": "View details"
          }
        },
        {
          "type": "service",
          "settings": {
            "label": "Delivery",
            "heading": "Catalog orders dispatch in 1–2 business days",
            "copy": "We ship worldwide from Heidelberg and share tracking as soon as your piece leaves the warehouse.",
            "link_label": "Shipping details"
          }
        },
        {
          "type": "service",
          "settings": {
            "label": "Payments",
            "heading": "Secure checkout with major payment methods",
            "copy": "Your final total, market currency, and available payment methods are confirmed before you pay.",
            "link_label": "Payment FAQ"
          }
        },
        {
          "type": "service",
          "settings": {
            "label": "Client care",
            "heading": "Human support by email and WhatsApp",
            "copy": "Need sizing, gifting, or bespoke help? Penya client care will guide you directly.",
            "link_label": "Contact client care"
          }
        }
      ]
    }
  ]
}
{% endschema %}
