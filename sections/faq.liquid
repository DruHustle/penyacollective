
{%- comment -%}
  FAQ accordion section.
  Add "Category" blocks to group questions under headings.
  Add "FAQ item" blocks for each question/answer pair.
  Uses native <details>/<summary> — no JavaScript required.
{%- endcomment -%}

<div class="faq page-width">

  <div class="faq__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="faq__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="faq__heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.intro_text != blank %}
      <p class="faq__subtext">{{ section.settings.intro_text }}</p>
    {% endif %}
  </div>

  <div class="faq__list">
    {% for block in section.blocks %}
      {% if block.type == 'category' %}
        <h2 class="faq__category" {{ block.shopify_attributes }}>{{ block.settings.title }}</h2>
      {% elsif block.type == 'faq_item' %}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">
            <span class="faq__question-text">{{ block.settings.question }}</span>
            <span class="faq__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <line class="faq__icon-h" x1="0" y1="9" x2="18" y2="9" stroke="currentColor" stroke-width="1.5"/>
                <line class="faq__icon-v" x1="9" y1="0" x2="9" y2="18" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>
          </summary>
          <div class="faq__answer rte">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.contact_text != blank %}
    <div class="faq__footer">
      <p>{{ section.settings.contact_text }}</p>
    </div>
  {% endif %}

</div>

{% stylesheet %}
  .faq {
    padding-block: 64px 80px;
    max-width: 760px;
    margin-inline: auto;
  }

  .faq__intro {
    margin-bottom: 3rem;
  }

  .faq__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .faq__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    margin-bottom: 1rem;
    color: var(--color-foreground-heading);
  }

  .faq__subtext {
    font-size: 1rem;
    line-height: 1.7;
    opacity: 0.7;
    max-width: 560px;
  }

  .faq__category {
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-top: 3rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  .faq__category:first-child {
    margin-top: 0;
  }

  .faq__item {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  .faq__item:first-of-type {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  /* suppress default browser marker */
  .faq__item > summary {
    list-style: none;
  }
  .faq__item > summary::-webkit-details-marker {
    display: none;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    cursor: pointer;
    user-select: none;
  }

  .faq__question:hover .faq__question-text {
    opacity: 0.7;
  }

  .faq__question-text {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--color-foreground-heading);
    transition: opacity 0.2s ease;
  }

  .faq__icon {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform 0.3s ease;
  }

  .faq__icon-v {
    transition: transform 0.3s ease;
    transform-origin: center;
  }

  .faq__item[open] .faq__icon-v {
    transform: scaleY(0);
  }

  .faq__answer {
    padding-bottom: 1.5rem;
    line-height: 1.8;
    color: var(--color-foreground);
    opacity: 0.85;
  }

  .faq__answer p {
    margin-bottom: 0.9rem;
  }

  .faq__answer p:last-child {
    margin-bottom: 0;
  }

  .faq__answer a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq__footer {
    margin-top: 3.5rem;
    padding: 2rem;
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
    border-radius: 4px;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .faq__footer a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .faq {
      padding-block: 40px 60px;
    }

    .faq__question-text {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Help & Information"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro text",
      "default": "Everything you need to know about ordering, shipping, and caring for your Penya pieces."
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Footer contact prompt",
      "default": "<p>Still have a question? Email us at <a href=\"mailto:info@penya.africa\">info@penya.africa</a> — we reply within one business day.</p>"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "Shipping"
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}
