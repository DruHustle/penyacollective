{%- comment -%}
  Homepage recognition and proof section.

  Dependency mapping:
  - Section blocks: recognition cards with links to designer stories
  - Homepage template: places the section after the designer grid to support the brand story
{%- endcomment -%}

<section class="penya-social-proof color-{{ section.settings.color_scheme }}" data-testid="penya-social-proof">
  <div class="page-width penya-social-proof__inner">
    <div class="penya-social-proof__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="penya-social-proof__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="penya-social-proof__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.copy != blank %}
        <div class="penya-social-proof__copy rte">
          {{ section.settings.copy }}
        </div>
      {% endif %}

      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="penya-social-proof__cta">
          {{ section.settings.link_label }}
        </a>
      {% endif %}
    </div>

    <div class="penya-social-proof__cards">
      {% for block in section.blocks %}
        {% liquid
          assign block_link = block.settings.link | default: '/pages/designer'
        %}

        <article class="penya-social-proof__card{% if forloop.first %} penya-social-proof__card--featured{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.label != blank %}
            <p class="penya-social-proof__label">{{ block.settings.label }}</p>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h3 class="penya-social-proof__card-heading">{{ block.settings.heading }}</h3>
          {% endif %}

          {% if block.settings.copy != blank %}
            <p class="penya-social-proof__card-copy">{{ block.settings.copy }}</p>
          {% endif %}

          <div class="penya-social-proof__card-footer">
            {% if block.settings.attribution != blank %}
              <p class="penya-social-proof__attribution">{{ block.settings.attribution }}</p>
            {% endif %}

            {% if block.settings.link_label != blank and block_link != blank %}
              <a href="{{ block_link }}" class="penya-social-proof__card-link">
                {{ block.settings.link_label }}
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .penya-social-proof {
    background:
      linear-gradient(180deg, rgb(var(--color-background-rgb)) 0%, rgb(var(--color-foreground-rgb) / 0.02) 100%);
  }

  .penya-social-proof__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .penya-social-proof__intro {
    max-width: 30rem;
  }

  .penya-social-proof__eyebrow {
    margin: 0 0 0.8rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .penya-social-proof__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 0.98;
    text-wrap: balance;
    color: var(--color-foreground-heading);
  }

  .penya-social-proof__copy {
    color: rgb(var(--color-foreground-rgb) / 0.78);
    line-height: 1.75;
  }

  .penya-social-proof__cta,
  .penya-social-proof__card-link {
    color: var(--color-foreground);
    text-decoration: none;
    font-family: var(--font-subheading--family);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    padding-bottom: 0.2rem;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .penya-social-proof__cta {
    display: inline-block;
    margin-top: 1.5rem;
  }

  .penya-social-proof__cta:hover,
  .penya-social-proof__card-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .penya-social-proof__cta:focus-visible,
  .penya-social-proof__card-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-color: var(--color-primary);
  }

  .penya-social-proof__cards {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  .penya-social-proof__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 15rem;
    padding: 1.5rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.09);
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }

  .penya-social-proof__card--featured {
    background:
      linear-gradient(180deg, rgb(var(--color-primary-rgb) / 0.08) 0%, rgb(var(--color-foreground-rgb) / 0.04) 100%);
  }

  @supports selector(.penya-social-proof__cards:has(.penya-social-proof__card:nth-child(3))) {
    .penya-social-proof__cards:has(.penya-social-proof__card:nth-child(3)) .penya-social-proof__card--featured {
      grid-row: span 2;
    }
  }

  .penya-social-proof__label {
    margin: 0 0 0.8rem;
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .penya-social-proof__card-heading {
    margin: 0 0 0.8rem;
    font-family: var(--font-heading--family);
    font-size: clamp(1.2rem, 2.2vw, 1.65rem);
    line-height: 1.18;
    color: var(--color-foreground-heading);
    text-wrap: balance;
  }

  .penya-social-proof__card-copy {
    margin: 0 0 1.1rem;
    color: rgb(var(--color-foreground-rgb) / 0.8);
    line-height: 1.72;
  }

  .penya-social-proof__card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .penya-social-proof__attribution {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  @media screen and (max-width: 989px) {
    .penya-social-proof__inner {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .penya-social-proof__cards {
      grid-template-columns: 1fr;
    }

    .penya-social-proof__card--featured {
      grid-row: auto;
    }

    .penya-social-proof__card {
      min-height: auto;
    }
  }
{% endstylesheet %}

