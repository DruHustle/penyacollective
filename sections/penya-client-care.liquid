{%- comment -%}
  Penya client care hero.

  Dependency mapping:
  - Template JSON provides page-level copy and action labels.
  - Theme settings keep support details editable without touching Liquid.
{%- endcomment -%}

{% liquid
  assign support_email = settings.penya_support_email | default: 'info@penya.africa'
  assign support_whatsapp_number = settings.penya_support_whatsapp_number | default: '4915147416152'
  assign support_whatsapp_display = settings.penya_support_whatsapp_display | default: '+49 1514 7416152'
  assign support_whatsapp_url = 'https://wa.me/' | append: support_whatsapp_number
  assign support_mailto = 'mailto:' | append: support_email

  assign primary_link = section.settings.primary_link
  assign secondary_link = section.settings.secondary_link
  assign email_address = section.settings.email_address
  assign whatsapp_url = section.settings.whatsapp_url
  assign whatsapp_text = section.settings.whatsapp_text

  if primary_link == blank or primary_link == 'mailto:info@penya.africa'
    assign primary_link = support_mailto
  endif

  if secondary_link == blank or secondary_link == 'https://wa.me/4915147416152'
    assign secondary_link = support_whatsapp_url
  endif

  if email_address == blank or email_address == 'info@penya.africa'
    assign email_address = support_email
  endif

  if whatsapp_url == blank or whatsapp_url == 'https://wa.me/4915147416152'
    assign whatsapp_url = support_whatsapp_url
  endif

  if whatsapp_text == blank or whatsapp_text == '+49 1514 7416152'
    assign whatsapp_text = support_whatsapp_display
  endif
%}

<section class="penya-client-care color-{{ section.settings.color_scheme }}">
  <div class="penya-client-care__inner page-width">
    <div class="penya-client-care__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="penya-client-care__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="penya-client-care__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.copy != blank %}
        <div class="penya-client-care__copy rte">
          {{ section.settings.copy }}
        </div>
      {% endif %}

      <div class="penya-client-care__actions">
        {% if section.settings.primary_label != blank and primary_link != blank %}
          <a href="{{ primary_link }}" class="button">
            {{ section.settings.primary_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank and secondary_link != blank %}
          <a href="{{ secondary_link }}" class="button button-secondary"{% if section.settings.secondary_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}

        {% if section.settings.text_link_label != blank and section.settings.text_link != blank %}
          <a href="{{ section.settings.text_link }}" class="penya-client-care__text-link">
            {{ section.settings.text_link_label }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="penya-client-care__cards">
      {% if email_address != blank %}
        <article class="penya-client-care__card">
          <p class="penya-client-care__card-label">{{ section.settings.email_label }}</p>
          <a href="mailto:{{ email_address }}" class="penya-client-care__card-link">{{ email_address }}</a>
          {% if section.settings.email_note != blank %}
            <p class="penya-client-care__card-copy">{{ section.settings.email_note }}</p>
          {% endif %}
        </article>
      {% endif %}

      {% if whatsapp_url != blank %}
        <article class="penya-client-care__card">
          <p class="penya-client-care__card-label">{{ section.settings.whatsapp_label }}</p>
          <a href="{{ whatsapp_url }}" class="penya-client-care__card-link" target="_blank" rel="noopener noreferrer">{{ whatsapp_text }}</a>
          {% if section.settings.whatsapp_note != blank %}
            <p class="penya-client-care__card-copy">{{ section.settings.whatsapp_note }}</p>
          {% endif %}
        </article>
      {% endif %}

      {% if section.settings.response_text != blank %}
        <article class="penya-client-care__card">
          <p class="penya-client-care__card-label">{{ section.settings.response_label }}</p>
          <p class="penya-client-care__card-strong">{{ section.settings.response_text }}</p>
          {% if section.settings.response_note != blank %}
            <p class="penya-client-care__card-copy">{{ section.settings.response_note }}</p>
          {% endif %}
        </article>
      {% endif %}

      {% if section.settings.address_text != blank %}
        <article class="penya-client-care__card penya-client-care__card--wide">
          <p class="penya-client-care__card-label">{{ section.settings.address_label }}</p>
          <div class="penya-client-care__card-copy rte">
            {{ section.settings.address_text }}
          </div>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .penya-client-care {
    background:
      linear-gradient(180deg, rgb(var(--color-background-rgb)) 0%, rgb(var(--color-background-rgb)) 65%, rgb(var(--color-foreground-rgb) / 0.03) 100%);
  }

  .penya-client-care__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-block: 3.5rem 1rem;
  }

  .penya-client-care__intro {
    max-width: 34rem;
  }

  .penya-client-care__eyebrow {
    margin: 0 0 0.85rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .penya-client-care__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 4vw, 4rem);
    line-height: 0.98;
    color: var(--color-foreground-heading);
    text-wrap: balance;
  }

  .penya-client-care__copy {
    font-size: 1rem;
    line-height: 1.8;
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .penya-client-care__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1rem;
    align-items: center;
    margin-top: 1.75rem;
  }

  .penya-client-care__text-link {
    color: var(--color-foreground);
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    padding-bottom: 0.15rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .penya-client-care__text-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .penya-client-care__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .penya-client-care__card {
    min-height: 12rem;
    padding: 1.35rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.09);
    background: rgb(var(--color-foreground-rgb) / 0.03);
  }

  .penya-client-care__card--wide {
    grid-column: 1 / -1;
    min-height: auto;
  }

  .penya-client-care__card-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .penya-client-care__card-link,
  .penya-client-care__card-strong {
    display: inline-block;
    margin: 0 0 0.65rem;
    font-family: var(--font-heading--family);
    font-size: 1.2rem;
    line-height: 1.35;
    color: var(--color-foreground-heading);
    text-decoration: none;
    text-wrap: balance;
  }

  .penya-client-care__card-link:hover {
    color: var(--color-primary);
  }

  .penya-client-care__card-copy {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .penya-client-care__card-copy p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .penya-client-care__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .penya-client-care__intro {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .penya-client-care__inner {
      padding-block: 2.5rem 0.75rem;
    }

    .penya-client-care__cards {
      grid-template-columns: 1fr;
    }

    .penya-client-care__card {
      min-height: auto;
    }
  }
{% endstylesheet %}

