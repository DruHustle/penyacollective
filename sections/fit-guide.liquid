
{%- comment -%}
  Fit Guide section.
  All copy, measurement steps, and size table rows are fully editable via the Shopify theme editor.
  Add "Measurement step" blocks for the how-to guide.
  Add "Size row" blocks for the size reference table.
{%- endcomment -%}

<div class="fit-guide page-width">

  <div class="fit-guide__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="fit-guide__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="fit-guide__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.intro_text != blank %}
      <p class="fit-guide__subtext">{{ section.settings.intro_text }}</p>
    {% endif %}
  </div>

  {% assign step_blocks = section.blocks | where: 'type', 'measurement_step' %}
  {% assign row_blocks = section.blocks | where: 'type', 'size_row' %}

  {% if step_blocks.size > 0 %}
    <div class="fit-guide__steps">
      {% for block in step_blocks %}
        <div class="fit-guide__step" {{ block.shopify_attributes }}>
          <span
            class="fit-guide__step-number"
            aria-label="Step {{ forloop.index }}"
          >{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="fit-guide__step-content">
            {% if block.settings.title != blank %}
              <h3 class="fit-guide__step-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}

  {% if row_blocks.size > 0 %}
    <div class="fit-guide__size-table">
      {% if section.settings.table_heading != blank %}
        <h3 class="fit-guide__table-heading">{{ section.settings.table_heading }}</h3>
      {% endif %}
      {% if section.settings.table_note != blank %}
        <p class="fit-guide__table-note">{{ section.settings.table_note }}</p>
      {% endif %}

      {%- comment -%} Detect which genders have rows so we only show relevant tabs {%- endcomment -%}
      {%- assign has_men   = false -%}
      {%- assign has_women = false -%}
      {%- assign has_kids  = false -%}
      {%- for block in row_blocks -%}
        {%- if block.settings.gender == 'men'   -%}{%- assign has_men   = true -%}{%- endif -%}
        {%- if block.settings.gender == 'women' -%}{%- assign has_women = true -%}{%- endif -%}
        {%- if block.settings.gender == 'kids'  -%}{%- assign has_kids  = true -%}{%- endif -%}
      {%- endfor -%}
      {%- assign tab_count = 0 -%}
      {%- if has_men   -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}
      {%- if has_women -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}
      {%- if has_kids  -%}{%- assign tab_count = tab_count | plus: 1 -%}{%- endif -%}
      {%- assign default_gender = 'men' -%}
      {%- if has_men == false and has_women -%}{%- assign default_gender = 'women' -%}{%- endif -%}
      {%- if has_men == false and has_women == false and has_kids -%}{%- assign default_gender = 'kids' -%}{%- endif -%}

      {%- comment -%} Find My Size calculator {%- endcomment -%}
      <div class="fit-guide__calculator" id="fit-calculator-{{ section.id }}">
        <p class="fit-guide__calculator-label">Find your size instantly</p>
        <div class="fit-guide__calculator-inputs">
          <label class="fit-guide__calc-field">
            <span class="fit-guide__chest-input-label">Chest</span>
            <input type="number" class="fit-guide__calc-input" data-measure="chest" min="60" max="160" placeholder="e.g. 90" aria-label="Chest measurement in centimetres">
            <span class="fit-guide__calc-unit">cm</span>
          </label>
          <label class="fit-guide__calc-field">
            <span>Waist</span>
            <input type="number" class="fit-guide__calc-input" data-measure="waist" min="50" max="140" placeholder="e.g. 74" aria-label="Waist measurement in centimetres">
            <span class="fit-guide__calc-unit">cm</span>
          </label>
          <label class="fit-guide__calc-field">
            <span>Hips</span>
            <input type="number" class="fit-guide__calc-input" data-measure="hips" min="60" max="160" placeholder="e.g. 98" aria-label="Hip measurement in centimetres">
            <span class="fit-guide__calc-unit">cm</span>
          </label>
          <button type="button" class="fit-guide__calc-btn button">Find My Size</button>
        </div>
        <p class="fit-guide__calc-result" aria-live="polite" hidden></p>
      </div>

      <div class="fit-guide__table-controls">
        {%- if tab_count > 1 -%}
          <div class="fit-guide__gender-tabs" role="tablist" aria-label="Sizing by gender" data-default-gender="{{ default_gender }}">
            {%- if has_men -%}
              <button type="button" class="fit-guide__gender-btn{% if default_gender == 'men' %} is-active{% endif %}" data-gender="men" role="tab" aria-selected="{% if default_gender == 'men' %}true{% else %}false{% endif %}">Men</button>
            {%- endif -%}
            {%- if has_women -%}
              <button type="button" class="fit-guide__gender-btn{% if default_gender == 'women' %} is-active{% endif %}" data-gender="women" role="tab" aria-selected="false">Women</button>
            {%- endif -%}
            {%- if has_kids -%}
              <button type="button" class="fit-guide__gender-btn{% if default_gender == 'kids' %} is-active{% endif %}" data-gender="kids" role="tab" aria-selected="false">Kids</button>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="fit-guide__unit-toggle" role="group" aria-label="Unit system">
          <button type="button" class="fit-guide__unit-btn is-active" data-unit="cm">CM</button>
          <button type="button" class="fit-guide__unit-btn" data-unit="in">IN</button>
        </div>
      </div>

      <div class="fit-guide__table-scroll">
        <table class="fit-guide__table" id="fit-table-{{ section.id }}">
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col" data-col="eu">EU</th>
              <th scope="col" data-col="us">US</th>
              <th scope="col" data-col="chest"><span class="fit-guide__chest-label">Chest</span> <span class="fit-guide__unit-label">(cm)</span></th>
              <th scope="col" data-col="waist">Waist <span class="fit-guide__unit-label">(cm)</span></th>
              <th scope="col" data-col="hips">Hips <span class="fit-guide__unit-label">(cm)</span></th>
            </tr>
          </thead>
          <tbody>
            {% for block in row_blocks %}
              {%- comment -%} Parse ranges to power the calculator and unit toggle {%- endcomment -%}
              {%- assign chest_parts = block.settings.chest | split: '–' -%}
              {%- assign waist_parts = block.settings.waist | split: '–' -%}
              {%- assign hips_parts  = block.settings.hips  | split: '–' -%}
              <tr
                {{ block.shopify_attributes }}
                data-gender="{{ block.settings.gender | default: 'men' }}"
                data-chest-min="{{ chest_parts[0] | strip | plus: 0 }}"
                data-chest-max="{{ chest_parts[1] | strip | plus: 0 }}"
                data-waist-min="{{ waist_parts[0] | strip | plus: 0 }}"
                data-waist-max="{{ waist_parts[1] | strip | plus: 0 }}"
                data-hips-min="{{ hips_parts[0] | strip | plus: 0 }}"
                data-hips-max="{{ hips_parts[1] | strip | plus: 0 }}"
              >
                <td>{{ block.settings.size_label }}</td>
                <td>{{ block.settings.eu }}</td>
                <td>{{ block.settings.us }}</td>
                <td data-cm="{{ block.settings.chest }}">{{ block.settings.chest }}</td>
                <td data-cm="{{ block.settings.waist }}">{{ block.settings.waist }}</td>
                <td data-cm="{{ block.settings.hips }}">{{ block.settings.hips }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}

  {% if section.settings.note_heading != blank or section.settings.note_text != blank %}
    <div class="fit-guide__note">
      {% if section.settings.note_heading != blank %}
        <h3>{{ section.settings.note_heading }}</h3>
      {% endif %}
      {% if section.settings.note_text != blank %}
        <p>{{ section.settings.note_text }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if section.settings.support_heading != blank or section.settings.support_text != blank or section.settings.support_primary_label != blank or section.settings.support_secondary_label != blank %}
    <div class="fit-guide__support">
      <div class="fit-guide__support-copy">
        {% if section.settings.support_heading != blank %}
          <h3>{{ section.settings.support_heading }}</h3>
        {% endif %}
        {% if section.settings.support_text != blank %}
          <p>{{ section.settings.support_text }}</p>
        {% endif %}
      </div>

      <div class="fit-guide__support-actions">
        {% if section.settings.support_primary_label != blank and section.settings.support_primary_link != blank %}
          <a href="{{ section.settings.support_primary_link }}" class="button">
            {{ section.settings.support_primary_label }}
          </a>
        {% endif %}

        {% if section.settings.support_secondary_label != blank and section.settings.support_secondary_link != blank %}
          <a href="{{ section.settings.support_secondary_link }}" class="fit-guide__support-link"{% if section.settings.support_secondary_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
            {{ section.settings.support_secondary_label }}
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}

</div>

{% stylesheet %}
  .fit-guide {
    padding-block: 80px;
  }

  .fit-guide__intro {
    max-width: 620px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .fit-guide__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .fit-guide__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .fit-guide__subtext {
    opacity: 0.75;
    line-height: 1.7;
  }

  .fit-guide__steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 4rem;
    margin-bottom: 5rem;
    max-width: 860px;
    margin-left: auto;
    margin-right: auto;
  }

  .fit-guide__step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .fit-guide__step-number {
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    padding-top: 0.25rem;
    flex-shrink: 0;
    min-width: 2rem;
  }

  .fit-guide__step-title {
    font-family: var(--font-heading--family);
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .fit-guide__step-content p {
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.8;
  }

  .fit-guide__size-table {
    max-width: 820px;
    margin: 0 auto 4rem;
  }

  .fit-guide__table-heading {
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .fit-guide__table-note {
    font-size: 0.875rem;
    opacity: 0.7;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .fit-guide__table-scroll {
    overflow-x: auto;
  }

  .fit-guide__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .fit-guide__table th,
  .fit-guide__table td {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
  }

  .fit-guide__table th {
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .fit-guide__table tbody tr {
    transition: background-color 0.15s ease;
  }

  .fit-guide__table tbody tr:hover {
    background-color: rgb(var(--color-foreground-rgb) / 0.08);
  }

  .fit-guide__note {
    max-width: 620px;
    margin: 0 auto;
    padding: 2rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 4px;
  }

  .fit-guide__note h3 {
    font-family: var(--font-heading--family);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .fit-guide__note p {
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.8;
  }

  .fit-guide__support {
    max-width: 820px;
    margin: 1.5rem auto 0;
    padding: 1.5rem 1.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    background-color: rgb(var(--color-foreground-rgb) / 0.03);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }

  .fit-guide__support-copy {
    max-width: 36rem;
  }

  .fit-guide__support-copy h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
  }

  .fit-guide__support-copy p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    opacity: 0.8;
  }

  .fit-guide__support-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
    align-items: center;
  }

  .fit-guide__support-link {
    color: var(--color-foreground);
    text-decoration: none;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.25);
    padding-bottom: 0.15rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .fit-guide__support-link:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* ── Find My Size calculator ──────────────────────────── */
  .fit-guide__calculator {
    background-color: rgb(var(--color-foreground-rgb) / 0.04);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    border-radius: 6px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .fit-guide__calculator-label {
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .fit-guide__calculator-inputs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-end;
  }

  .fit-guide__calc-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground);
    opacity: 0.75;
    position: relative;
  }

  .fit-guide__calc-input {
    width: 100px;
    padding: 0.55rem 2.2rem 0.55rem 0.75rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 3px;
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.95rem;
    font-family: var(--font-body--family);
    -moz-appearance: textfield;
  }

  .fit-guide__calc-input::-webkit-outer-spin-button,
  .fit-guide__calc-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
  }

  .fit-guide__calc-input:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }

  .fit-guide__calc-unit {
    position: absolute;
    right: 0.6rem;
    bottom: 0.55rem;
    font-size: 0.7rem;
    opacity: 0.5;
    pointer-events: none;
  }

  .fit-guide__calc-btn {
    height: 38px;
    font-size: 0.8rem;
    padding-inline: 1.25rem;
    white-space: nowrap;
  }

  .fit-guide__calc-result {
    margin-top: 0.875rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .fit-guide__calc-result.is-match {
    color: var(--color-primary);
    font-weight: 600;
  }

  .fit-guide__calc-result.is-no-match {
    opacity: 0.65;
  }

  /* ── Gender tabs ──────────────────────────────────────── */
  .fit-guide__gender-tabs {
    display: flex;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 3px;
    overflow: hidden;
  }

  .fit-guide__gender-btn {
    padding: 0.3rem 1.25rem;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    opacity: 0.5;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }

  .fit-guide__gender-btn.is-active {
    background-color: var(--color-foreground-heading);
    color: var(--color-background);
    opacity: 1;
  }

  .fit-guide__table tbody tr[hidden] {
    display: none;
  }

  /* ── Unit toggle ───────────────────────────────────────── */
  .fit-guide__table-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .fit-guide__unit-toggle {
    display: flex;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 3px;
    overflow: hidden;
  }

  .fit-guide__unit-btn {
    padding: 0.3rem 0.75rem;
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-foreground);
    opacity: 0.5;
    transition: background-color 0.15s ease, opacity 0.15s ease;
  }

  .fit-guide__unit-btn.is-active {
    background-color: var(--color-primary);
    color: var(--color-background);
    opacity: 1;
  }

  /* ── Highlighted size row ─────────────────────────────── */
  .fit-guide__table tbody tr.is-highlighted {
    background-color: rgb(var(--color-primary-rgb, 0 0 0) / 0.08);
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .fit-guide__table tbody tr.is-highlighted td:first-child {
    font-weight: 700;
    color: var(--color-primary);
  }

  @media screen and (max-width: 749px) {
    .fit-guide {
      padding-block: 48px 64px;
    }

    .fit-guide__steps {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .fit-guide__step {
      gap: 1rem;
      padding: 1.25rem;
      border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
      border-radius: 4px;
    }

    .fit-guide__calculator-inputs {
      gap: 0.6rem;
    }

    .fit-guide__calc-input {
      width: 80px;
    }

    .fit-guide__support {
      align-items: flex-start;
      padding: 1.25rem;
    }

    .fit-guide__support-actions {
      width: 100%;
      align-items: flex-start;
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    // ── Gender tabs ──────────────────────────────────────────
    document.querySelectorAll('.fit-guide__gender-tabs').forEach(function (tabs) {
      var tableSection = tabs.closest('.fit-guide__size-table');
      var table = tableSection.querySelector('.fit-guide__table');
      var chestLabel = table.querySelector('.fit-guide__chest-label');
      var chestInputLabel = tableSection.querySelector('.fit-guide__chest-input-label');

      function setGender(gender) {
        // Update tab state
        tabs.querySelectorAll('.fit-guide__gender-btn').forEach(function (btn) {
          var active = btn.dataset.gender === gender;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        // Show/hide rows
        table.querySelectorAll('tbody tr').forEach(function (row) {
          row.hidden = row.dataset.gender !== gender;
        });

        // Chest → Bust for women only; kids and men use "Chest"
        var label = gender === 'women' ? 'Bust' : 'Chest';
        if (chestLabel) chestLabel.textContent = label;
        if (chestInputLabel) chestInputLabel.textContent = label;

        // Clear result and highlights on switch
        table.querySelectorAll('tbody tr').forEach(function (r) { r.classList.remove('is-highlighted'); });
        var result = tableSection.querySelector('.fit-guide__calc-result');
        if (result) { result.hidden = true; result.textContent = ''; }
      }

      tabs.querySelectorAll('.fit-guide__gender-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { setGender(btn.dataset.gender); });
      });

      // Initialise using the server-rendered default gender
      setGender(tabs.dataset.defaultGender || 'men');
    });

    // ── Unit toggle ──────────────────────────────────────────
    function convertRange(str, toInches) {
      const factor = toInches ? 0.3937 : 2.54;
      return str.replace(/[\d.]+/g, function (n) {
        return Math.round(parseFloat(n) * factor * 10) / 10;
      });
    }

    function convertMeasurementValue(value, toInches) {
      const numeric = parseFloat(value);
      if (Number.isNaN(numeric)) return value;
      const factor = toInches ? 0.3937 : 2.54;
      return String(Math.round(numeric * factor * 10) / 10);
    }

    document.querySelectorAll('.fit-guide__unit-toggle').forEach(function (toggle) {
      const section = toggle.closest('.fit-guide__size-table');
      const table = section.querySelector('.fit-guide__table');
      const unitLabels = table.querySelectorAll('.fit-guide__unit-label');
      const calcUnits = section.querySelectorAll('.fit-guide__calc-unit');

      toggle.querySelectorAll('.fit-guide__unit-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const toInches = btn.dataset.unit === 'in';
          const currentUnitInput = section.querySelector('.fit-guide__calc-input');
          const currentlyInches = currentUnitInput && currentUnitInput.dataset.unit === 'in';
          if (toInches === currentlyInches) return;

          toggle.querySelectorAll('.fit-guide__unit-btn').forEach(function (b) {
            b.classList.toggle('is-active', b === btn);
          });
          unitLabels.forEach(function (lbl) {
            lbl.textContent = toInches ? '(in)' : '(cm)';
          });
          calcUnits.forEach(function (u) {
            u.textContent = toInches ? 'in' : 'cm';
          });
          table.querySelectorAll('tbody td[data-cm]').forEach(function (td) {
            const cm = td.dataset.cm;
            td.textContent = toInches ? convertRange(cm, true) : cm;
          });
          // Update calculator input placeholders and limits
          section.querySelectorAll('.fit-guide__calc-input').forEach(function (input) {
            // Cache original CM bounds on first toggle so they can always be restored.
            if (input.dataset.minCm === undefined) input.dataset.minCm = input.min;
            if (input.dataset.maxCm === undefined) input.dataset.maxCm = input.max;

            if (input.value !== '') {
              input.value = convertMeasurementValue(input.value, toInches);
            }

            if (toInches) {
              input.dataset.unit = 'in';
              input.min = Math.round(parseFloat(input.dataset.minCm) * 0.3937 * 10) / 10;
              input.max = Math.round(parseFloat(input.dataset.maxCm) * 0.3937 * 10) / 10;
              input.step = '0.1';
              input.placeholder = input.dataset.measure === 'chest' ? 'e.g. 35.4'
                : input.dataset.measure === 'waist' ? 'e.g. 29.1'
                : 'e.g. 38.6';
              input.setAttribute('aria-label', input.dataset.measure + ' measurement in inches');
            } else {
              input.dataset.unit = 'cm';
              input.min = input.dataset.minCm;
              input.max = input.dataset.maxCm;
              input.step = '1';
              input.placeholder = input.dataset.measure === 'chest' ? 'e.g. 90'
                : input.dataset.measure === 'waist' ? 'e.g. 74'
                : 'e.g. 98';
              input.setAttribute('aria-label', input.dataset.measure + ' measurement in centimetres');
            }
          });
        });
      });
    });

    // ── Find My Size calculator ──────────────────────────────
    document.querySelectorAll('.fit-guide__calculator').forEach(function (calc) {
      const btn = calc.querySelector('.fit-guide__calc-btn');
      const result = calc.querySelector('.fit-guide__calc-result');
      const tableSection = calc.closest('.fit-guide__size-table');
      const tableEl = tableSection && tableSection.querySelector('.fit-guide__table');

      if (!btn || !tableEl) return;

      btn.addEventListener('click', function () {
        const chestInput = calc.querySelector('[data-measure="chest"]');
        const waistInput = calc.querySelector('[data-measure="waist"]');
        const hipsInput  = calc.querySelector('[data-measure="hips"]');

        const isInches = chestInput.dataset.unit === 'in';
        const factor = isInches ? 2.54 : 1;

        const chest = parseFloat(chestInput.value) * factor;
        const waist = parseFloat(waistInput.value) * factor;
        const hips  = parseFloat(hipsInput.value) * factor;

        if (!chest && !waist && !hips) {
          result.textContent = 'Enter at least one measurement to find your size.';
          result.className = 'fit-guide__calc-result is-no-match';
          result.hidden = false;
          return;
        }

        // Remove any existing highlight
        tableEl.querySelectorAll('tbody tr').forEach(function (r) {
          r.classList.remove('is-highlighted');
        });

        // Only search rows visible in the active gender tab
        const rows = Array.from(tableEl.querySelectorAll('tbody tr')).filter(function (r) { return !r.hidden; });
        let matched = null;

        for (const row of rows) {
          const d = row.dataset;
          const chestOk = !chest || (chest >= parseFloat(d.chestMin) && chest <= parseFloat(d.chestMax));
          const waistOk = !waist || (waist >= parseFloat(d.waistMin) && waist <= parseFloat(d.waistMax));
          const hipsOk  = !hips  || (hips  >= parseFloat(d.hipsMin)  && hips  <= parseFloat(d.hipsMax));
          if (chestOk && waistOk && hipsOk) { matched = row; break; }
        }

        if (matched) {
          matched.classList.add('is-highlighted');
          matched.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          const sizeName = matched.cells[0].textContent.trim();
          result.textContent = 'Your recommended size is ' + sizeName + '. The row is highlighted in the table below.';
          result.className = 'fit-guide__calc-result is-match';
        } else {
          // No exact match — find closest by chest
          if (chest) {
            const closest = rows.reduce(function (best, row) {
              const mid = (parseFloat(row.dataset.chestMin) + parseFloat(row.dataset.chestMax)) / 2;
              const bestMid = (parseFloat(best.dataset.chestMin) + parseFloat(best.dataset.chestMax)) / 2;
              return Math.abs(mid - chest) < Math.abs(bestMid - chest) ? row : best;
            });
            closest.classList.add('is-highlighted');
            const sizeName = closest.cells[0].textContent.trim();
            result.textContent = 'Your measurements fall outside our standard ranges. The closest size is ' + sizeName + '. Contact us at info@penya.africa for a bespoke fit.';
          } else {
            result.textContent = 'We could not find an exact match. Email us at info@penya.africa and we will advise you.';
          }
          result.className = 'fit-guide__calc-result is-no-match';
        }

        result.hidden = false;
      });
    });
  })();
{% endjavascript %}

