{%- comment -%}
  Penya story hero.

  Dependency mapping:
  - Theme settings: optional uploaded hero image for easy override.
  - Theme assets: fallback image filename so the section never falls back to a placeholder.
  - Template JSON: copy and CTA wiring for the About page.
{%- endcomment -%}

{% liquid
  assign hero_image = section.settings.hero_image
  assign hero_asset = section.settings.hero_image_asset | strip
  assign hero_alt = section.settings.hero_image_alt | default: section.settings.heading

  if hero_asset == blank
    assign hero_asset = 'blog-penya-collective.jpg'
  endif
%}

<div class="penya-story-hero color-{{ section.settings.color_scheme }}">
  <div class="penya-story-hero__inner page-width">
    <div class="penya-story-hero__media">
      {% if hero_image != blank %}
        {{
          hero_image
          | image_url: width: 2000
          | image_tag:
            widths: '480, 720, 960, 1280, 1600, 2000',
            sizes: '(min-width: 990px) 48vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'penya-story-hero__image',
            alt: hero_alt
        }}
      {% else %}
        <img
          src="{{ hero_asset | asset_url }}"
          alt="{{ hero_alt | escape }}"
          class="penya-story-hero__image"
          loading="eager"
          fetchpriority="high"
          width="1200"
          height="1440"
        >
      {% endif %}
    </div>

    <div class="penya-story-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="penya-story-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="penya-story-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.copy != blank %}
        <div class="penya-story-hero__copy rte">
          {{ section.settings.copy }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <div class="penya-story-hero__actions">
          <a href="{{ section.settings.button_link }}" class="button button-secondary">
            {{ section.settings.button_label }}
          </a>
        </div>
      {% endif %}

      {% assign story_notes = '' %}
      {% if section.settings.note_one != blank %}
        {% assign story_notes = story_notes | append: section.settings.note_one | append: '|' %}
      {% endif %}
      {% if section.settings.note_two != blank %}
        {% assign story_notes = story_notes | append: section.settings.note_two | append: '|' %}
      {% endif %}
      {% if section.settings.note_three != blank %}
        {% assign story_notes = story_notes | append: section.settings.note_three | append: '|' %}
      {% endif %}
      {% assign story_notes = story_notes | split: '|' | compact %}

      {% if story_notes.size > 0 %}
        <div class="penya-story-hero__notes" aria-label="Penya story highlights">
          {% for note in story_notes %}
            <span class="penya-story-hero__note">{{ note }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .penya-story-hero {
    background:
      radial-gradient(circle at top left, rgb(var(--color-primary-rgb) / 0.08), transparent 32%),
      rgb(var(--color-background-rgb));
  }

  .penya-story-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: 0;
  }

  .penya-story-hero__media {
    position: relative;
    overflow: hidden;
    min-height: clamp(25rem, 62vh, 44rem);
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .penya-story-hero__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 22%;
    background: linear-gradient(to top, rgb(0 0 0 / 0.12), transparent);
    pointer-events: none;
  }

  .penya-story-hero__image {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    display: block;
  }

  .penya-story-hero__content {
    max-width: 34rem;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .penya-story-hero__eyebrow {
    margin: 0 0 0.85rem;
    font-family: var(--font-subheading--family);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .penya-story-hero__heading {
    margin: 0 0 1rem;
    font-family: var(--font-heading--family);
    font-size: clamp(2.25rem, 4vw, 4.25rem);
    line-height: 0.98;
    color: var(--color-foreground-heading);
    text-wrap: balance;
  }

  .penya-story-hero__copy {
    font-size: 1rem;
    line-height: 1.8;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .penya-story-hero__copy p {
    margin: 0;
  }

  .penya-story-hero__actions {
    margin-top: 1.75rem;
  }

  .penya-story-hero__notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .penya-story-hero__note {
    display: inline-flex;
    align-items: center;
    min-height: 2.3rem;
    padding: 0.5rem 0.8rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 999px;
    font-family: var(--font-subheading--family);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
    background: rgb(var(--color-background-rgb) / 0.82);
    backdrop-filter: blur(8px);
  }

  @media screen and (max-width: 989px) {
    .penya-story-hero__inner {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .penya-story-hero__content {
      max-width: 100%;
      padding-inline: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .penya-story-hero__media {
      min-height: 22rem;
      margin-inline: calc(var(--page-margin) * -1);
    }

    .penya-story-hero__content {
      padding-block: 2rem 3rem;
    }

    .penya-story-hero__heading {
      font-size: clamp(2rem, 10vw, 3rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Penya story hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_image_asset",
      "label": "Fallback asset filename",
      "default": "blog-penya-collective.jpg",
      "info": "Uses a theme asset when no image is uploaded in the editor."
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Glow Has a Story."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Copy",
      "default": "<p>Born in Harare. Built to make every designer in Africa shine.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Meet the Collective"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "note_one",
      "label": "Highlight one",
      "default": "Founded in Harare"
    },
    {
      "type": "text",
      "id": "note_two",
      "label": "Highlight two",
      "default": "Collective-first"
    },
    {
      "type": "text",
      "id": "note_three",
      "label": "Highlight three",
      "default": "Small-batch craftsmanship"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Penya story hero"
    }
  ]
}
{% endschema %}
